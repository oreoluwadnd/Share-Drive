# The FairDrive API the app talks to. Copy this file to .env and set your own.
# Running the API on your laptop for a phone on the same Wi-Fi: your laptop's Wi-Fi address.
EXPO_PUBLIC_API_URL=http://192.168.1.20:8000
# Deployed (Railway): the service's public address, for example
# EXPO_PUBLIC_API_URL=https://fairdrive-api.up.railway.app
